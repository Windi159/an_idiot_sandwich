# 복사해서 .env 로 저장하면 서버 시작 시 읽힌다. (이미 설정된 환경 변수가 우선)

# 엔진: llamacpp (16GB GPU, 이 PC) | qwen3_omni_hf (80GB급 GPU, 완전한 STS) | mock (모델 없이 테스트)
STS_ENGINE=llamacpp

# --- llama.cpp 엔진에서 쓸 모델 (sts_server/models.py)
#   qwen3-omni-30b : Qwen3-Omni-30B-A3B, q4 (VRAM ~15.9GB)
#   gemma4-12b     : Gemma 4 12B, q4 = Google QAT 4bit (기본, VRAM ~8GB) | q8 = 8bit (VRAM ~13GB)
STS_MODEL=gemma4-12b
STS_QUANT=q4

# STS_LLAMA_URL=http://127.0.0.1:8081
# STS_LLAMA_AUTOSTART=true
# MoE expert 를 CPU 로 내릴 레이어 수. -1 = 모델 기본값 (Qwen3-Omni 12, Gemma 0)
# STS_LLAMA_N_CPU_MOE=-1
# STS_LLAMA_CTX=8192

# --- transformers 엔진 (Qwen3-Omni 가 직접 음성 출력)
# STS_HF_MODEL=Qwen/Qwen3-Omni-30B-A3B-Instruct
# STS_SPEAKER=Ethan          # Ethan | Chelsie | Aiden
# STS_HF_ATTN=sdpa           # flash-attn 설치 시 flash_attention_2

# --- 모델이 음성을 못 낼 때 (llama.cpp 엔진) 쓰는 TTS
#   supertonic : 로컬 CPU, 문장당 ~0.4s (기본). 음성 F1(기본) F2~F5 M1~M5
#   windows    : 로컬, 음질 낮음 / edge : 온라인(Microsoft), 음성 ko-KR-InJoonNeural 등
STS_FALLBACK_TTS=supertonic
# STS_FALLBACK_VOICE=F1

# --- /api/transcribe 백엔드: omni | whisper
# STS_STT_BACKEND=omni

# --- RAG: none | jsonl (글자 매칭) | hybrid (글자 매칭 + KR-SBERT 임베딩) | chroma
#   STS_RAG_JSONL 은 ; 로 여러 파일: 앱 질문/답 + RAG_자료 문서 청크
STS_RAG_BACKEND=hybrid
STS_RAG_JSONL=D:\post_sh-t\app\src\main\assets\train_data_standardized.jsonl;D:\multi model test\data\rag_source\RAG_자료\rag_chunks.jsonl
# STS_RAG_CHROMA_DIR=D:\path\to\chroma_db
# STS_RAG_CHROMA_COLLECTION=langchain
# STS_RAG_TOP_K=3

# --- danger 로 분류됐는데 위협 단어가 없을 때 내릴 값
# STS_DANGER_UNVERIFIED_AS=ignore

# --- 서버
# STS_HOST=0.0.0.0
# STS_PORT=8000
